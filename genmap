import java.util.HashMap;
import java.util.Map;
import java.util.Scanner;

public class GenericMapExample {

    // Generic method to print key-value pairs
    public static <K, V> void printMap(Map<K, V> map) {

        for (Map.Entry<K, V> entry : map.entrySet()) {
            System.out.println(entry.getKey() + " -> " + entry.getValue());
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        Map<String, Integer> studentMarks = new HashMap<>();

        System.out.print("Enter number of entries: ");
        int n = sc.nextInt();
        sc.nextLine();

        // Taking user input
        for (int i = 0; i < n; i++) {

            System.out.print("Enter key (Name): ");
            String key = sc.nextLine();

            System.out.print("Enter value (Marks): ");
            int value = sc.nextInt();
            sc.nextLine();

            studentMarks.put(key, value);
        }

        System.out.println("\nKey-Value Pairs:");
        printMap(studentMarks);

        sc.close();
    }
}
